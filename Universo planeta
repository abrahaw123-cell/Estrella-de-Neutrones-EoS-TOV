def create_4d_animation(history):
    import plotly.graph_objects as go
    x = np.array(history['x']); z = np.array(history['z'])
    t = np.array(history['t'])
    step = max(1, len(x)//200)
    fig = go.Figure(
        data=[go.Scatter(x=x, y=z, mode='lines', line=dict(color='cyan', width=2), name='Trayectoria')],
        layout=go.Layout(
            title="Animación 4D del Descenso (Tiempo como color)",
            xaxis=dict(title="Distancia horizontal (m)", range=[x.min(), x.max()]),
            yaxis=dict(title="Altitud (m)", range=[0, z.max()*1.05]),
            updatemenus=[dict(type="buttons", showactive=False,
                              buttons=[dict(label="▶ Reproducir", method="animate", args=[None, {"frame": {"duration": 50, "redraw": True}, "fromcurrent": True}])])]
        ),
        frames=[go.Frame(data=[go.Scatter(x=[x[i]], y=[z[i]], mode='markers',
                                         marker=dict(size=8, color='red', symbol='circle'))])
                for i in range(0, len(x), step)]
    )
    fig.show()


